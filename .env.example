# NEXUS OS — local environment
# Copy to `.env` (gitignored) and fill in. Never commit real values.

NEXUS_ENV=local
NEXUS_DEBUG=true

# ── Database ────────────────────────────────────────────────
# Postgres with pgvector. Per ADR 0001 (no Docker) this is a free hosted
# instance locally — Supabase or Neon. Must support: CREATE EXTENSION vector;
# Note the +asyncpg driver prefix.
NEXUS_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# ── Secrets ─────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_SESSION_SECRET=
NEXUS_STORAGE_SIGNING_SECRET=

# ── Local infrastructure substitutes (ADR 0001) ─────────────
NEXUS_STORAGE_BACKEND=filesystem
NEXUS_MAILER_BACKEND=file

# ── Embeddings (ADR 0003) ───────────────────────────────────
# Local, free, no API key. ~1.1 GB downloaded to ./models on first run.
NEXUS_EMBEDDING_MODEL_ID=intfloat/multilingual-e5-large
NEXUS_EMBEDDING_DIM=1024

# ── Not needed yet — listed so the shape is known ───────────
# Blocks M7  · doc 05 §3.7 requires real keyword volumes, never estimated
# NEXUS_DATAFORSEO_LOGIN=
# NEXUS_DATAFORSEO_PASSWORD=
# Blocks M2 (PageSpeed) and M10 (GA4 + Search Console OAuth)
# NEXUS_GOOGLE_CLIENT_ID=
# NEXUS_GOOGLE_CLIENT_SECRET=
# NEXUS_PAGESPEED_API_KEY=
# Blocks M12
# NEXUS_ANTHROPIC_API_KEY=
