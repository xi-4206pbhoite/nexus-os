* text=auto eol=lf

# Shell scripts must be LF even on Windows: CRLF fails at the shebang with
# 'bad interpreter', and in the Postgres init hook that failure is silent.
*.sh text eol=lf
*.sql text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.woff binary
*.woff2 binary
